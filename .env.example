GEMINI_API_KEY=
GOOGLE_API_KEY=

# Optional Vertex AI Gemini mode. Cloud Run should have roles/aiplatform.user.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=promptwars-fade
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.0-flash

# Server-side Maps Platform key for Places API (New) and Routes API.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_ENRICHMENT_ENABLED=true
GOOGLE_MAPS_TIMEOUT_SECONDS=4

# Browser-restricted key for Maps Embed API only.
GOOGLE_MAPS_EMBED_API_KEY=

# Optional Google Analytics 4 measurement ID.
GOOGLE_ANALYTICS_ID=

PORT=8080
